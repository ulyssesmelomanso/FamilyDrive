# Copy this file to .env.local locally and add the same values in Vercel.

# Neon Postgres connection string.
DATABASE_URL=

# Vercel Blob token. Used to archive encrypted Excel uploads.
BLOB_READ_WRITE_TOKEN=

# Required when using Blob archives. Use a long random value and keep it private.
ARCHIVE_ENCRYPTION_KEY=

# Cookie/session signing secret. Use a long random value in production.
AUTH_SECRET=

# Admin login.
ADMIN_USERNAME=familydrive
ADMIN_PASSWORD=familydrive

# Investor login.
INVESTOR_USERNAME=wessiemens
INVESTOR_PASSWORD=12345

# Optional fallback only. If DATABASE_URL is missing, the app can still show the previous preview data.
GOOGLE_SHEET_URL=
USE_MOCK_DATA=false
